<?xml version="1.0" encoding="utf-8"?>
<!--
  Claude Launcher has no NuGet dependencies since v1.5.0 (the TUI is rendered by
  src/Tui/*). Clearing the package sources means the default, framework-dependent
  build never touches the network, so install.cmd works offline and behind a
  corporate proxy.

  Self-contained publishing IS an exception: it needs the win-x64 runtime pack
  from nuget.org, so scripts/publish-standalone.ps1 and the release workflow
  override this file by passing nuget.org on the command line.

  If you ever add a PackageReference, delete this file (or re-add nuget.org).
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
