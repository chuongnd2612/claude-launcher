<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClaudeLauncher</AssemblyName>
    <RootNamespace>ClaudeLauncher</RootNamespace>
    <Version>1.5.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- v1.5.0: no NuGet dependencies. The TUI is rendered with a custom
       truecolor ANSI renderer so the build works fully offline. -->
</Project>
